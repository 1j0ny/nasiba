{
  "buildCommand": "pnpm --filter @workspace/revenue-architecture run build",
  "outputDirectory": "artifacts/revenue-architecture/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/architecture", "destination": "/revenue-architecture", "permanent": true }
  ]
}
